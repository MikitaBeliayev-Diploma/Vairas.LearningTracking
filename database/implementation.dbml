Ref: assessment_result_version.(readiness_decision_id, school_id, readiness_id) > readiness_decision.(id, school_id, readiness_id)
Ref: assessment_topic_result.(result_version_id, school_id, definition_version_id) > assessment_result_version.(id, school_id, definition_version_id)
Ref: assessment_topic_result.(assessment_topic_id, school_id, definition_version_id) > assessment_topic.(id, school_id, definition_version_id)
Ref: training_evidence_snapshot.(enrollment_id, school_id, program_version_id) > student_training.(id, school_id, program_version_id)
