Ref: training_evidence_item.(practical_record_version_id, school_id, enrollment_id) > practical_record_version.(id, school_id, enrollment_id)
Ref: training_evidence_item.(result_version_id, school_id, enrollment_id) > assessment_result_version.(id, school_id, enrollment_id)
Ref: training_evidence_item.(theory_attendance_id, school_id, enrollment_id) > theory_attendance.(id, school_id, enrollment_id)
Ref: training_evidence_item.(readiness_decision_id, school_id, enrollment_id) > readiness_decision.(id, school_id, enrollment_id)
Ref: training_evidence_check.(snapshot_id, school_id, enrollment_id) > training_evidence_snapshot.(id, school_id, enrollment_id)
Ref: training_evidence_check.(evidence_item_id, school_id, snapshot_id) > training_evidence_item.(id, school_id, snapshot_id)
Ref: reporting_declaration.(snapshot_id, school_id) > training_evidence_snapshot.(id, school_id)
Ref: learning_audit_event.(source_snapshot_id, school_id) > lesson_source_snapshot.(id, school_id)

// Implementation-only storage. The adopted 31 domain tables above remain intact.
Table lesson_planning_policy {
 id uuid [pk]
 school_id uuid [not null]
 program_version_id uuid [not null]
 kind lt_training_kind [not null]
 lesson_minutes int [not null]
 allow_short_final_lesson boolean [not null]
 minimum_final_lesson_minutes int [not null]
 indexes { (school_id,program_version_id,kind) [unique] }
 checks {
  `lesson_minutes > 0`
  `minimum_final_lesson_minutes > 0 AND minimum_final_lesson_minutes <= lesson_minutes`
 }
}
Ref: lesson_planning_policy.(program_version_id,school_id) > training_program_version.(id,school_id)
Table learning_operation {
 id uuid [not null]
 school_id uuid [not null]
 actor_id uuid [not null]
 fingerprint text [not null]
 command text [not null]
 result_json text [not null]
 result_id uuid [not null]
 applied_at timestamptz [not null]
 indexes { (school_id,id) [pk] }
}
Table outbox_message {
 id uuid [pk]
 school_id uuid [not null]
 aggregate_id uuid [not null]
 aggregate_version bigint [not null]
 event_type text [not null]
 payload text [not null]
 correlation_id text [not null]
 occurred_at timestamptz [not null]
 sent_at timestamptz
 lease_id uuid
 lease_until timestamptz
 attempts int [not null]
 next_attempt_at timestamptz [not null]
 indexes { (sent_at,next_attempt_at) }
 checks {
  `aggregate_version > 0`
  `attempts >= 0`
  `(lease_id IS NULL) = (lease_until IS NULL)`
 }
}
Table inbox_message {
 id uuid [pk]
 school_id uuid [not null]
 producer text [not null]
 event_type text [not null]
 aggregate_id uuid [not null]
 aggregate_version bigint [not null]
 fingerprint text [not null]
 processed_at timestamptz [not null]
 checks { `aggregate_version > 0` }
}
Table enrollment_source_state {
 id uuid [pk]
 school_id uuid [not null]
 revision bigint [not null]
 status text [not null]
 verified_at timestamptz [not null]
 checks { `revision > 0` }
}
Table policy_attestation {
 id uuid [not null]
 school_id uuid [not null]
 checksum text [not null]
 attested_at timestamptz [not null]
 indexes { (school_id,id) [pk] }
}
Table school_source_state {
 id uuid [pk]
 school_id uuid [not null]
 revision bigint [not null]
 last_verified_at timestamptz [not null]
 checks {
  `revision > 0`
  `id = school_id`
 }
}
